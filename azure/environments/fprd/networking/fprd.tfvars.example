node_subnet_cidr = ""

# Every AWS VPC of the rebuilt estate: eco, fstg, fprd, fdev, shd.
reserved_cidrs = [
  "10.10.0.0/16",
  "10.20.0.0/16",
  "10.30.0.0/16",
  "10.40.0.0/16",
  "10.50.0.0/16",
]
