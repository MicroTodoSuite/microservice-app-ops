# Copy to fprd.tfvars (gitignored) and fill the values the DR preflight
# (spec 009 T124) verifies from the live account (PC-IAC-024).
client          = "lex"
project         = "mts"
environment     = "fprd"
subscription_id = ""
location        = ""

# The planned 10.50.0.0/16 VNet from research decision 8 belongs to the AWS shd
# egress hub. The maintainer selected 10.60.0.0/16 and its first /22 node
# subnet on 2026-09-21; T124 still confirms them against live evidence.
vnet_cidr        = "10.60.0.0/16"
node_subnet_cidr = "10.60.0.0/22"

# Every AWS VPC of the rebuilt estate: eco, fstg, fprd, fdev, shd.
reserved_cidrs = [
  "10.10.0.0/16",
  "10.20.0.0/16",
  "10.30.0.0/16",
  "10.40.0.0/16",
  "10.50.0.0/16",
]

# Proposed label of the static ingress address; T124 confirms it is free in
# the selected region.
ingress_dns_label = "lex-mts-fprd-dr"
