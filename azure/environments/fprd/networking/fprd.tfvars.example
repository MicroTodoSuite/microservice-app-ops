# Copy to fprd.tfvars (gitignored) and fill the values the DR preflight
# (spec 009 T124) verifies from the live account (PC-IAC-024).
client          = "lex"
project         = "mts"
environment     = "fprd"
subscription_id = ""
location        = ""

# Placeholders: research decision 8 planned 10.50.0.0/16, which the AWS shd hub
# VPC now owns, so T124 must select another collision-free range.
