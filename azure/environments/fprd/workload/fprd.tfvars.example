# Copy to fprd.tfvars (gitignored) and fill the values the DR preflight
# (spec 009 T124) verifies from the live account (PC-IAC-024).
client          = "lex"
project         = "mts"
environment     = "fprd"
subscription_id = ""
location        = ""

# The four approved operator addresses (spec 009 FR-012, FR-016).
operator_cidrs = [
  "181.50.102.191/32",
  "186.112.71.16/32",
  "190.108.77.190/32",
  "200.3.193.225/32",
]

# Every AWS VPC of the rebuilt estate: eco, fstg, fprd, fdev, shd.
reserved_cidrs = [
  "10.10.0.0/16",
  "10.20.0.0/16",
  "10.30.0.0/16",
  "10.40.0.0/16",
  "10.50.0.0/16",
]

# Placeholders the DR preflight selects: pod and service ranges clear of the
# VNet, each other, and every AWS VPC.
pod_cidr       = ""
service_cidr   = ""
dns_service_ip = ""

# The T179 minimum-inventory sizing (gitops specs/009 T133 scope
# reconciliation): the subscription allows six regional vCPUs, four in the
# DSv4 family, and none in DSv5. Two Standard_D2s_v4 nodes (2 vCPUs, 8 GiB
# each) at most: max_count * vcpus <= regional_vcpu_quota. T124 confirms the
# family quota in the selected region.
system_node_pool = {
  vm_size   = "Standard_D2s_v4"
  vcpus     = 2
  min_count = 1
  max_count = 2
}
regional_vcpu_quota = 4

# Entra groups whose members administer the cluster; local accounts are off.
cluster_admin_group_object_ids = []
