# Copy this file to slack-approval-gateway.s3.tfbackend before initializing
# this root. Do not add credentials to this file.
#
# Dev-owned shared tooling, the same ownership pattern as the SonarQube
# admin/db secrets (specs/009-full-platform-rollout/research.md): the bucket,
# region, and kms_key_id must be byte-identical to
# aws/environments/dev/foundation/dev.s3.tfbackend. Only the key differs.
bucket       = "microtodosuite-tfstate-123456789012-us-east-1-dev"
key          = "shared/slack-approval-gateway/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
