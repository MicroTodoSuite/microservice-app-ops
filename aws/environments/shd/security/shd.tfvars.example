# Copy to shd.tfvars (gitignored) and fill the account from config/aws-account.env and the
# operators' IAM principals by hand.
client              = "lex"
project             = "mts"
environment         = "shd"
aws_account_id      = "123456789012"
aws_region          = "us-east-1"
deploy_role_arn     = "arn:aws:iam::123456789012:role/<terraform-deploy-role>"
github_organization = "MicroTodoSuite"
image_publisher_repositories = [
  "microservice-app-auth-api",
  "microservice-app-frontend",
  "microservice-app-log-message-processor",
  "microservice-app-todos-api",
  "microservice-app-users-api",
]
service_image_keys        = ["authapi", "frontend", "logmsgproc", "todosapi", "usersapi"]
deploy_role_operator_arns = ["arn:aws:iam::123456789012:user/<operator>"]
