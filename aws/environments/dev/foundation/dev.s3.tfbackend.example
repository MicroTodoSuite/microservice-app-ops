# Copy this file to dev.s3.tfbackend only after the backend bootstrap has been
# separately authorized and provisioned. Do not add credentials to this file.
bucket       = "microtodosuite-tfstate-123456789012-us-east-1-dev"
key          = "environments/dev/foundation/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
