# Copy to fprd.tfvars (gitignored) and fill the account from config/aws-account.env. The
# namespaces are the GitOps application environments' (microservice-app-gitops environments/*).
client          = "lex"
project         = "mts"
environment     = "fprd"
aws_account_id  = "123456789012"
aws_region      = "us-east-1"
deploy_role_arn = "arn:aws:iam::123456789012:role/<terraform-deploy-role>"
jwt_reader_namespaces = {
  dev = "microtodo-dev"
  stg = "microtodo-staging"
  prd = "microtodo-prod"
  dmo = "microtodo-demo"
}
service_image_keys = ["authapi", "frontend", "logmsgproc", "todosapi", "usersapi"]
# The DNS-01 solvers stay off until T134. The two zone inputs take no default, so set them
# to null until then, or to shd/dns's canonical zone.
enable_dns01_solvers = false
aks_oidc_issuer_url  = null
canonical_zone_id    = null
canonical_zone_name  = null
# enable_dns01_solvers = true
# aks_oidc_issuer_url  = "https://<region>.oic.prod-aks.azure.com/<tenant-id>/<issuer-id>/"
# canonical_zone_id    = "Z0000000000000000000"
# canonical_zone_name  = "microtodosuite.online"
