# Copy to eco.tfvars (gitignored) and fill the account from config/aws-account.env. The
# network values are the legacy dev root's, kept for the first bring-up in this layout.
client               = "lex"
project              = "mts"
environment          = "eco"
aws_account_id       = "123456789012"
aws_region           = "us-east-1"
deploy_role_arn      = "arn:aws:iam::123456789012:role/<terraform-deploy-role>"
vpc_cidr             = "10.10.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24", "10.10.2.0/24"]
private_subnet_cidrs = ["10.10.16.0/20", "10.10.32.0/20", "10.10.48.0/20"]
